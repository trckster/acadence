{
  "name": "acadence",
  "version": "0.9.1",
  "description": "Multi-user Claude Code and Codex usage window scheduler",
  "type": "module",
  "bin": {
    "acadence": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": "github:trckster/acadence",
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@js-temporal/polyfill": "^0.5.1",
    "commander": "^15.0.0",
    "fastify": "^5.12.7",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "npm@12.2.1",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
